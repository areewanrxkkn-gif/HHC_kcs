rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /patients/{patientId} {
      allow read: if true;
      allow write: if isValidId(patientId);
    }

    match /visits/{visitId} {
      allow read: if true;
      allow write: if isValidId(visitId);
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);
    }

    match /config/{configId} {
      allow read, write: if isValidId(configId);
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
